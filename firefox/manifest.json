{
  "manifest_version": 2,
  "name": "CacheBuddy",
  "version": "1.1.1",
  "description": "Manually save a page or linked site pages and reopen them when their original URLs fail offline.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "unlimitedStorage"
  ],
  "incognito": "not_allowed",
  "background": {
    "page": "capture.html",
    "persistent": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "CacheBuddy",
    "default_icon": "icons/32.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cachebuddy@yapperyap.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
